+func TestParseDate_numericString(t *testing.T) {
+	// Unix timestamp as string
+	dt, err := ParseDate("1152098955")
+	require.NoError(t, err)
+	require.Equal(t, time.Unix(1152098955, 0), dt)
+
+	// Zero timestamp
+	dt, err = ParseDate("0")
+	require.NoError(t, err)
+	require.Equal(t, time.Unix(0, 0), dt)
+}

